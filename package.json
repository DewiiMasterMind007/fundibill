{
  "name": "fundibill",
  "version": "1.0.0",
  "description": "FundiBill - SA Built Invoicing Software",
  "main": "electron/main.js",
  "author": "FundiAI <info@fundiai.co.za>",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "cross-env ELECTRON=true vite build",
    "dist": "npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:all": "npm run build:electron && electron-builder --win --mac",
    "build:win": "node scripts/create-icon.js && cross-env ELECTRON=true vite build && electron-builder --win --x64",
    "rebuild-native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.105.4",
    "buffer": "^6.0.3",
    "electron-updater": "^6.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^7.2.0"
  }
}
